# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交

# 服务监听端口（开发默认 8080，与 Dockerfile 的 EXPOSE 一致）
PORT=8080

# Postgres 连接串（Neon 请使用池化地址）
DATABASE_URL=postgres://user:password@localhost:5432/dialogue_search

# Postgres 直连串（Neon 请用不带 -pooler 的地址）：仅 db:migrate 与语料管线使用；
# 不填则回退到 DATABASE_URL。`neon deploy` 会自动把它写进 .env.local
DATABASE_URL_UNPOOLED=

# 运行环境：线上（Render）设为 production；生产环境会拒绝 STORAGE_DRIVER=local（必须 R2）
# NODE_ENV=production

# 素材存储驱动：local（读 work/mp4，仅本地开发）或 r2（线上，也用于执行 pipeline upload）
STORAGE_DRIVER=local

# local 驱动读取视频的目录；不填默认 <仓库根>/work/mp4
# MEDIA_DIR=

# Cloudflare R2 凭据（STORAGE_DRIVER=r2 时必填）；桶保持私有，令牌只给「对象读写」
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tbbt-media

# 站点外部地址，用来拼分享链接
PUBLIC_BASE_URL=http://localhost:5173

# 权利声明 / 投诉邮箱（可选，写在仓库根 .env / .env.local）：构建时注入前端，页脚显示「邮件联系投诉」
# 格式须为 KEY=value，等号两侧勿加空格
VITE_COMPLAINT_EMAIL=rights@example.com
