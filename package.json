{
  "name": "dialogue-search",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "pipeline",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pipeline": "npm run start -w pipeline --",
    "db:migrate": "npm run db:migrate -w server",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15"
  }
}
